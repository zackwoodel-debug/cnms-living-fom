# ---------------------------------------------------------------------------
# CNMS Living FOM — environment template.  Copy to .env and edit.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
POSTGRES_USER=cnms
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=cnms_fom
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Full URL wins over the individual fields above if set.
# Inside docker-compose the host is "db", not "localhost".
DATABASE_URL=postgresql+psycopg2://cnms:change-me-in-production@localhost:5432/cnms_fom

# pgvector is optional. When false, embeddings fall back to a JSON column and
# similarity search is computed in Python (fine for a few thousand chunks).
PGVECTOR_ENABLED=true
EMBEDDING_DIM=768

# --- Retrieval / LLM provider ---------------------------------------------
# "ollama" keeps every corpus excerpt on this machine. That is the default
# because the corpus is unpublished CNMS process documentation and user work.
# "anthropic" trades that locality for a model that follows the retrieval
# discipline more reliably — declining when the evidence is thin, carrying a
# growth parameter's full context, refusing to average disagreeing sources.
# Switching it means retrieved excerpts are sent to a remote API. Decide that
# per corpus, not once.
RAG_LLM_PROVIDER=ollama

# --- Ollama (local LLM, no data leaves the machine) ------------------------
# Inside docker-compose the host is "ollama", not "localhost".
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Optional small model for relevance grading and query rewriting. These run once
# per retrieved candidate and are 0-3 classifications, so they dominate the wall
# clock while needing none of the answer model's reasoning. Measured on this
# scaffold: 173 s to grade 7 candidates on a 14B reasoning model, 29 s on a 1B one,
# for the same decisions. Leave unset to use OLLAMA_CHAT_MODEL.
RAG_GRADER_MODEL=gemma3:1b

# --- Anthropic (only read when RAG_LLM_PROVIDER=anthropic) ----------------
# Leave the key blank to let the SDK resolve credentials itself
# (ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN, or an `ant auth login` profile).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Server-side refusal fallback: a policy decline re-runs on a fallback model
# inside the same call instead of returning nothing.
ANTHROPIC_REFUSAL_FALLBACKS=true

# --- Corpus storage -------------------------------------------------------
# Where uploaded PDFs land. Under docker-compose ./data is mounted at /app/data,
# so the same relative path works inside and outside the container.
CORPUS_DIR=data/pdfs
MAX_UPLOAD_MB=100

# --- Research assistant ---------------------------------------------------
# Tool-call budget for one turn. Past this the assistant is asked to answer from
# what it already retrieved, or to report a data gap.
ASSISTANT_MAX_STEPS=6
# Prior exchanges replayed to the model. Evidence is stored for every turn
# regardless; this only bounds what goes back into the prompt.
ASSISTANT_HISTORY_TURNS=6

# --- API ------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Analysis defaults (see docs/FOM_PROTOCOL.md) -------------------------
# FOM_PROOF Eq. (42): >= 10,000 permutations for any finally reported matrix.
PERMUTATION_B=10000
RANDOM_SEED=20260823
# FOM_PROOF Eq. (26): numerical floor for the geometric score.
SCORE_FLOOR_EPS=1e-3

# --- CNMS integration (placeholders — fill in from CNMS systems) ----------
# TODO(CNMS): point these at the real endpoints once credentials are issued.
CNMS_PROPOSAL_API_URL=
CNMS_INSTRUMENT_REGISTRY_URL=
CNMS_API_TOKEN=
